# ---------------------------------------------------------------------------
# Nullpoint environment. Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder; the app runs in offline demo mode
# without any keys (deterministic mock agents + synthetic/sample data).
# ---------------------------------------------------------------------------

# Core
APP_ENV=development                 # development | staging | production
APP_NAME=Nullpoint
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=720
SANDBOX_BACKEND=auto                 # auto | docker | local (production requires docker)
ENGINE_SANDBOX=false                 # true in production: run every backtest inside the sandbox

# Database. sqlite works with no infrastructure so the app runs out of the box; Docker Compose
# overrides this with Postgres for the full stack.
DATABASE_URL=sqlite:///./nullpoint.db
# Docker Compose / staging / production:
# DATABASE_URL=postgresql+psycopg://nullpoint:nullpoint@localhost:5432/nullpoint
# Dev/test convenience only. Production and staging run `alembic upgrade head` instead.
AUTO_CREATE_SCHEMA=true

# Redis / job queue
REDIS_URL=redis://localhost:6379/0
JOB_RUNNER=auto                      # auto | arq | subprocess | sync (tests only)
JOB_MAX_ATTEMPTS=3
JOB_STALE_MINUTES=120

# Data lake
LAKE_ROOT=./.lake
DATA_CACHE_TTL_HOURS=24
DATA_READ_ONLY=true

# LLM agents
# Any OpenAI-compatible endpoint works: openai | openrouter | groq | deepseek |
# mistral | xai | together | fireworks | gemini | ollama | custom
# `custom` requires LLM_BASE_URL (Azure, vLLM, LM Studio, etc.).
LLM_PROVIDER=auto                    # auto prefers OpenRouter free models when keyed
LLM_API_KEY=                         # generic key; provider-specific keys below also work
LLM_BASE_URL=                        # optional override, e.g. https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=90
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=                  # free OpenRouter models are the default when set
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# auto -> free OpenRouter router for OpenRouter, provider default otherwise
MODEL_ORCHESTRATOR=auto
MODEL_WORKER=auto
MODEL_CHEAP=auto
MODEL_SKEPTIC=auto
LLM_MONTHLY_BUDGET_USD=250
SPRINT_BUDGET_USD=8
SPRINT_WALL_CLOCK_MINUTES=45
MAX_AGENT_ITERATIONS=3
# 0 = auto-detect from CPU/cgroup limits; 1 forces sequential execution.
MAX_WORKERS=0

# Voyage knowledge base (optional; falls back to local embeddings)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
VOYAGE_BASE_URL=https://api.voyageai.com/v1/embeddings
KNOWLEDGE_CHUNK_CHARS=1400

# Web research providers (all optional; agents degrade honestly without them)
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
WEB_SEARCH_PROVIDERS=tavily,exa,firecrawl
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_TIMEOUT_SECONDS=25
WEB_SEARCH_CACHE_TTL_SECONDS=900

# Free data providers (all optional)
YFINANCE_ENABLED=true
STOOQ_ENABLED=true
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
TIINGO_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
SEC_EDGAR_USER_AGENT=Nullpoint research contact@example.com

# Paper trading (never live: the platform has no live-trading hook)
MIN_PAPER_DAYS=30                   # final claim gate, distinct paper days
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true
CCXT_TESTNET=true

# Alerts
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nullpoint-api

# Auth (stub in v0: local users + API keys; swap for Clerk/Auth0 later)
AUTH_MODE=local                      # local | clerk
CLERK_JWKS_URL=
CLERK_ISSUER=

# Billing (stretch, disabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
