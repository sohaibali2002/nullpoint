# ---------------------------------------------------------------------------
# Nullpoint environment. Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder; the app runs in offline demo mode
# without any keys (deterministic mock agents + synthetic/sample data).
# ---------------------------------------------------------------------------

# Core
APP_ENV=development                 # development | staging | production
APP_NAME=Nullpoint
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=720

# Database (Postgres in compose; sqlite fallback for local tests)
DATABASE_URL=postgresql+psycopg://nullpoint:nullpoint@localhost:5432/nullpoint
# DATABASE_URL=sqlite:///./nullpoint.db

# Redis / job queue
REDIS_URL=redis://localhost:6379/0

# Data lake
LAKE_ROOT=./.lake
DATA_CACHE_TTL_HOURS=24
DATA_READ_ONLY=true

# LLM agents
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic              # anthropic | mock
MODEL_ORCHESTRATOR=claude-opus-5-5
MODEL_WORKER=claude-sonnet-5-5
MODEL_CHEAP=claude-haiku-5-5
MODEL_SKEPTIC=claude-opus-5-5
LLM_MONTHLY_BUDGET_USD=250
SPRINT_BUDGET_USD=8
SPRINT_WALL_CLOCK_MINUTES=45
MAX_AGENT_ITERATIONS=3

# Free data providers (all optional)
YFINANCE_ENABLED=true
STOOQ_ENABLED=true
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
TIINGO_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
SEC_EDGAR_USER_AGENT=Nullpoint research contact@example.com

# Paper trading (never live: the platform has no live-trading hook)
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true
CCXT_TESTNET=true

# Alerts
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nullpoint-api

# Auth (stub in v0: local users + API keys; swap for Clerk/Auth0 later)
AUTH_MODE=local                      # local | clerk
CLERK_JWKS_URL=
CLERK_ISSUER=

# Billing (stretch, disabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
